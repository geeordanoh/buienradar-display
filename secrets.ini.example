# -----------------------------------------------------------------------------
# Buienradar display – flash-time configuration
# -----------------------------------------------------------------------------
# The firmware reads WiFi credentials and the location to display from the
# shell environment at BUILD/FLASH time. Nothing secret is committed to git.
#
# Usage: copy this file to `secrets.sh`, fill it in, then before flashing run:
#
#     source secrets.sh
#     pio run -t upload
#
# (`secrets.sh` is git-ignored.) Alternatively pass them inline on one line:
#
#     WIFI_SSID="MyNetwork" WIFI_PASS="hunter2" \
#     LATITUDE=52.0907 LONGITUDE=5.1214 LOCATION_NAME="Utrecht" \
#     pio run -t upload
# -----------------------------------------------------------------------------

export WIFI_SSID="MyNetwork"
export WIFI_PASS="hunter2"

# Location to show weather for (decimal degrees).
export LATITUDE=52.0907
export LONGITUDE=5.1214

# Short label shown in the header (optional).
export LOCATION_NAME="Utrecht"
